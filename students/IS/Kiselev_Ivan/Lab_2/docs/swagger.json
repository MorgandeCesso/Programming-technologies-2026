{
    "swagger": "2.0",
    "info": {
        "description": "Сообщения о находках и потерях: извлечение полей локальной моделью и сохранение в PostgreSQL.",
        "title": "Бюро находок",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/lost-found": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "lost-found"
                ],
                "summary": "Список сообщений",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/internal.RecordResponse"
                            }
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "lost-found"
                ],
                "summary": "Принять сообщение",
                "parameters": [
                    {
                        "description": "Текст сообщения",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal.CreateRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal.RecordResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/internal.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/internal.ErrorResponse"
                        }
                    },
                    "504": {
                        "description": "Gateway Timeout",
                        "schema": {
                            "$ref": "#/definitions/internal.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/lost-found/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "lost-found"
                ],
                "summary": "Одна запись",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID записи",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal.RecordResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/internal.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal.CreateRequest": {
            "type": "object",
            "required": [
                "message"
            ],
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Сегодня около 10 утра нашёл чёрный зонт у стойки охраны, локация LOC-03. На ручке красная лента."
                }
            }
        },
        "internal.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "bad_request"
                },
                "message": {
                    "type": "string",
                    "example": "Поле message обязательно и не может состоять из пробелов"
                }
            }
        },
        "internal.RecordResponse": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string",
                    "enum": [
                        "lost",
                        "found",
                        "claim",
                        "other"
                    ]
                },
                "created_at": {
                    "type": "string"
                },
                "details": {
                    "type": "string"
                },
                "event_time": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "item_description": {
                    "type": "string"
                },
                "location_code": {
                    "type": "string"
                },
                "location_id": {
                    "type": "integer"
                },
                "match_status": {
                    "type": "string",
                    "enum": [
                        "matched",
                        "not_found",
                        "not_provided"
                    ]
                },
                "message": {
                    "type": "string"
                },
                "summary": {
                    "type": "string"
                }
            }
        }
    }
}